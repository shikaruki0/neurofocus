# Optional cloud sync. The app remains fully usable in local-only mode without these.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional: extra EXACT origins allowed to start/return Google sign-in.
# The live app origin (https://neurofocusx.vercel.app) is built in.
# Wildcards are never supported — never add https://*.vercel.app here.
# VITE_AUTH_ALLOWED_ORIGINS=http://localhost:5173

VITE_APP_TITLE=NeuroFocusX
VITE_APP_VERSION=14.0.0
