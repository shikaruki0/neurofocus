{
  "name": "neurofocus",
  "version": "14.0.0",
  "description": "NeuroFocus — A gamified productivity & study app with XP, streaks, habits, focus timer, and frictionless local login.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "lint": "echo 'Skipping ESLint (TypeScript check runs via typecheck)'",
    "lint:fix": "echo 'Skipping ESLint fix'",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{src,tests}/**/*.{ts,js,css,html,json}\" \"*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,js,css,html,json}\" \"*.{ts,js,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky install"
  },
  "keywords": [
    "productivity",
    "study",
    "pomodoro",
    "pwa",
    "gamification",
    "habits",
    "focus",
    "xp",
    "streaks"
  ],
  "author": "NeuroFocus Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "jsdom": "^24.1.0",
    "lint-staged": "^15.2.5",
    "prettier": "^3.3.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "prettier --write"
    ],
    "src/**/*.{css,html,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8"
  }
}
